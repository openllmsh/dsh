{
  "name": "@openllm/dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) bundle that routes the harness through the OpenLLM gateway (OpenAI-compatible) and registers the OpenLLM MCP server, with a boot-time onboarding step that installs or guides the OpenLLM CLI + daemon.",
  "keywords": ["dsh-plugin", "deepseek-harness", "cordis", "openllm", "mcp", "llm-gateway"],
  "license": "MIT",
  "type": "module",
  "main": "lib/onboarding.js",
  "types": "lib/onboarding.d.ts",
  "exports": {
    ".": {
      "types": "./lib/onboarding.d.ts",
      "default": "./lib/onboarding.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openllmsh/dsh.git"
  },
  "homepage": "https://openllm.sh",
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-questions": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "tsdown": "^0.12.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
